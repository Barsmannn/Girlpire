[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "CHANGE_ME_RANDOM_SECRET"

[auth.google]
client_id = "GOOGLE_CLIENT_ID_HERE"
client_secret = "GOOGLE_CLIENT_SECRET_HERE"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[lemonsqueezy]
checkout_url = "YOUR_LEMONSQUEEZY_SUBSCRIPTION_CHECKOUT_URL"
api_key = "YOUR_LEMONSQUEEZY_API_KEY"
store_id = "YOUR_STORE_ID"
variant_id = "YOUR_SUBSCRIPTION_VARIANT_ID"
webhook_secret = "YOUR_WEBHOOK_SECRET"

[nowpayments]
api_key = "YOUR_NOWPAYMENTS_API_KEY"

[groq]
api_key = "YOUR_GROQ_API_KEY"

[app]
admin_mode = true
app_url = "http://localhost:8501"
